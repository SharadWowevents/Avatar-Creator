{
  "name": "customer-avatar-creator-mern",
  "version": "1.0.0",
  "description": "Customer Avatar Creator - MERN Stack Application",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "start": "node backend/server.js",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test": "cd backend && npm test"
  },
  "keywords": [
    "mern",
    "customer-avatar",
    "react",
    "express",
    "mongodb",
    "nodejs",
    "openai",
    "gpt-6-luna"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
